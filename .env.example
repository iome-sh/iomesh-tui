# Copy to .env (never commit). Loaded manually by the shell / direnv if desired.
# iomesh reads process environment; it does not auto-load .env files yet.

DEEPSEEK_API_KEY=
XAI_API_KEY=
# Optional Gemini / Vertex (OpenAI-compatible endpoints; pin with -m)
GEMINI_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# VERTEX_API_KEY=
IOMESH_TOKEN=
# IOMESH_API_KEY=          # fallback if IOMESH_TOKEN is unset
IOMESH_ENDPOINT=
IOMESH_TENANT=
# IOMESH_ORG=                 # optional X-IOMesh-Org (org_ + cuid2). Empty fail-opens (aion #2721).
# IOMESH_WORKSPACE=
IOMESH_DEFAULT_MODEL=
IOMESH_SUBAGENTS=1
# IOMESH_YOLO=0
